# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key-here

# Server-only (Never exposed to client / browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key-here
SUPABASE_SECRET_KEY=your-service-role-or-secret-key-here

# Application URL
NEXT_PUBLIC_APP_URL=https://kryinpanel.vercel.app

# Optional Google Drive configuration backups. Use a separate Web OAuth client.
BACKUP_GOOGLE_CLIENT_ID=
BACKUP_GOOGLE_CLIENT_SECRET=
BACKUP_GOOGLE_REDIRECT_URI=https://kryincraftpanel.vercel.app/api/server/backups/drive/callback
BACKUP_ENCRYPTION_KEY=
